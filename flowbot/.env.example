# ─── Telegram ────────────────────────────────────────────────────────────────
# SECRET — from @BotFather. Never commit a filled-in value; it can send messages
# as your bot. Everything else in this file is public chain data.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the Mini App — the signing surface. Telegram silently
# refuses to open a Mini App over plain http, which looks like a broken button
# rather than a config error. This is the /miniapp route in the Onyx Next.js app.
MINIAPP_URL=https://onyx-dex.vercel.app/miniapp

# ─── Arc network ─────────────────────────────────────────────────────────────
# Values below are taken from the LIVE Onyx deployment (web/lib/contracts.ts) —
# the same chain and contracts onyx-dex.vercel.app talks to, so the bot cannot
# quote one deployment while the site shows another.
#
# `npm run check-config` re-verifies this file against web/lib/contracts.ts and
# fails if they ever drift apart.
#
# Startup validation also asks the RPC which chain it actually is and refuses to
# run on a mismatch — a wrong RPC/chainId doesn't error, it succeeds on the
# wrong network.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app

# On Arc the native USDC gas balance is 18-dec while the ERC-20 interface is
# 6-dec. Every trading amount in this codebase is 6-dec ERC-20 units.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ─── Onyx DEX contracts (Arc testnet) ────────────────────────────────────────
ONYX_ROUTER=0x52F9Df11DAE5Af839c28216e2d4f8ab678219312
ONYX_ORDERBOOK=0x6E04B607Fe10F2A6005d9A843A866129b7274810
ONYX_QUOTER=0xf2346e79Ab9D92c5e6B5D949331F186a5e040461
ONYX_STABLESWAP=0x3Bf8E6EfF4850D8172c019CeEeA00787928162De
ONYX_TWAP=0x1081ea6642F8f67dc1ff8A40b8A60900c0180dBE

# Not read by the bot — StableSwap calls it internally. Listed so the full
# deployment is documented in one place.
# ONYX_RATEPROVIDER=0x5BD82828Ffd74d7d9df5B0266d8F8Dc6f05f6d74

# ─── CCTP (cross-chain deposits) ─────────────────────────────────────────────
# Testnet CCTP V2 uses the same deterministic CREATE2 addresses on every EVM
# chain. Cross-checked against Arc's docs and two Circle launch posts.
CCTP_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# CONFIRMED against Circle's official docs: Arc's CCTP domain is 26.
# A domain id is NOT a chain id. 7 is Polygon PoS — setting it here would mint
# users' deposits on a chain they can't reach, so startup validation rejects 7.
CCTP_ARC_DOMAIN=26
CCTP_IRIS_URL=https://iris-api-sandbox.circle.com

# ─── Storage ─────────────────────────────────────────────────────────────────
# Holds telegram_id, settings, order history, and an opt-in ENCRYPTED keystore
# backup. Never a password, mnemonic, or plaintext key.
DATABASE_URL=file:./flowbot.db

# Optional: sessions + rate limiting.
REDIS_URL=

# ─── Referrals ───────────────────────────────────────────────────────────────
# Share of trading fees credited to a referrer, in bps. 0 = off (default).
# Tracking-only today: Onyx's Router takes no referrer parameter, so paying this
# out needs contract support. Don't advertise a share that isn't actually paid.
REFERRAL_FEE_BPS=0

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300          # hard ceiling; no UI path may exceed it
HIGH_IMPACT_WARN_BPS=100      # warn above this price impact
RATE_LIMIT_PER_MIN=20

# ─── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather. A secret: it can send messages as your bot.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the Mini App — the signing surface. Telegram refuses to
# open a Mini App over plain http. This is the /miniapp route in the Onyx
# Next.js app, e.g. https://onyx-dex.vercel.app/miniapp
MINIAPP_URL=

# ─── Arc network ─────────────────────────────────────────────────────────────
# ⚠️ UNVERIFIED. The values below are placeholders.
# VERIFY against docs.arc.network before running — wrong RPC/chainId = silent
# failures or wrong-network txs. The bot validates these at startup, including
# asking the RPC which chain it actually is, and refuses to run on a mismatch.
ARC_RPC_URL=
ARC_CHAIN_ID=

# CONFIRMED — Arc's public testnet explorer.
ARC_EXPLORER=https://testnet.arcscan.app

# ⚠️ UNVERIFIED — VERIFY against docs.arc.network before running.
# On Arc the native USDC gas balance is 18-dec while the ERC-20 interface is
# 6-dec. All trading amounts here are 6-dec ERC-20 units.
USDC_ADDRESS=
EURC_ADDRESS=

# ─── Onyx DEX contracts ──────────────────────────────────────────────────────
# ⚠️ UNVERIFIED — VERIFY against docs.arc.network (and your own deployment)
# before running. Wrong addresses mean transactions to contracts that either
# revert or, worse, aren't the ones you think they are.
ONYX_ROUTER=
ONYX_ORDERBOOK=
ONYX_QUOTER=
ONYX_STABLESWAP=
ONYX_TWAP=

# ─── CCTP (cross-chain deposits) ─────────────────────────────────────────────
# ⚠️ UNVERIFIED — VERIFY against developers.circle.com before running.
CCTP_TOKEN_MESSENGER=
CCTP_MESSAGE_TRANSMITTER=

# CONFIRMED against Circle's official docs: Arc's CCTP domain is 26.
# A domain id is NOT a chain id. 7 is Polygon PoS — setting it here would mint
# users' deposits on the wrong chain, so startup validation rejects 7 outright.
CCTP_ARC_DOMAIN=26
CCTP_IRIS_URL=https://iris-api-sandbox.circle.com

# ─── Storage ─────────────────────────────────────────────────────────────────
# Holds telegram_id, settings, order history, and an opt-in ENCRYPTED keystore
# backup. Never a password, mnemonic, or plaintext key.
DATABASE_URL=file:./flowbot.db

# Optional: sessions + rate limiting.
REDIS_URL=

# ─── Referrals ───────────────────────────────────────────────────────────────
# Share of trading fees credited to a referrer, in bps. 0 = off (default).
# Tracking-only today: Onyx's Router takes no referrer parameter, so paying this
# out needs contract support. Don't advertise a share that isn't actually paid.
REFERRAL_FEE_BPS=0

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300          # hard ceiling; no UI path may exceed it
HIGH_IMPACT_WARN_BPS=100      # warn above this price impact
RATE_LIMIT_PER_MIN=20

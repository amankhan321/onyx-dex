# ─── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather. Treat as a secret: it can send messages as your bot.
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the Mini App (the signing surface). Must be HTTPS —
# Telegram refuses to open a webview otherwise. Recommended: a route on the
# existing Onyx app, e.g. https://onyx-dex.vercel.app/miniapp
MINIAPP_URL=

# ─── Arc network ─────────────────────────────────────────────────────────────
# ⚠️ VERIFY BEFORE MAINNET: RPC URL, chain ID and every Onyx address below are
# testnet values that have NOT been independently confirmed. Only the CCTP
# domain (26) has been verified against Circle's official docs. Check each one
# against the live deployment before any real funds are involved.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app

# Gas on Arc is paid in USDC. Native balance is 18-dec; the ERC-20 interface is
# 6-dec. Always read balances through the ERC-20 interface to avoid mixing them.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ─── Onyx DEX contracts (Arc testnet) ────────────────────────────────────────
ONYX_ROUTER=0x52F9Df11DAE5Af839c28216e2d4f8ab678219312
ONYX_ORDERBOOK=0x6E04B607Fe10F2A6005d9A843A866129b7274810
ONYX_QUOTER=0xf2346e79Ab9D92c5e6B5D949331F186a5e040461
ONYX_STABLESWAP=0x3Bf8E6EfF4850D8172c019CeEeA00787928162De
ONYX_TWAP=0x1081ea6642F8f67dc1ff8A40b8A60900c0180dBE

# ─── CCTP (deposits from other chains) ───────────────────────────────────────
# Verified against Arc docs + Circle launch posts. Arc's CCTP domain is 26.
# DO NOT change this from memory — a wrong domain mints user USDC on the wrong
# chain. (A widely-shared blog post claiming Arc is domain 7 is wrong; 7 is
# Polygon PoS.)
CCTP_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
CCTP_ARC_DOMAIN=26
CCTP_IRIS_URL=https://iris-api-sandbox.circle.com

# ─── Storage ─────────────────────────────────────────────────────────────────
# Stores telegram_id, the ENCRYPTED keystore blob, settings, order history.
# It must never contain a password, mnemonic, or plaintext key.
DATABASE_URL=file:./flowbot.db

# Optional: sessions + per-user rate limiting.
REDIS_URL=

# ─── Referrals ───────────────────────────────────────────────────────────────
# Share of trading fees credited to a referrer, in bps. 0 = off (default).
# Tracking-only today: Onyx's Router takes no referrer parameter, so paying this
# out needs contract support or a separate transfer. Don't advertise a share
# that isn't actually paid.
REFERRAL_FEE_BPS=0

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300          # hard ceiling the UI cannot exceed
HIGH_IMPACT_WARN_BPS=100      # warn the user above this price impact
RATE_LIMIT_PER_MIN=20
